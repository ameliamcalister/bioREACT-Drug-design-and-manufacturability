# Secrets — never commit
.env
loop/.env

# Per-run output, regenerated every time
loop/run_log.json
loop/eval_results.json
loop/candidates.csv
loop/manufacture_report.json
loop/bioreact_run.json

# Uploaded source files for a target (the prepared receptor IS committed)
loop/targets/*/uploads/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/
dist/
build/
*.log

.DS_Store

# NOTE: loop/targets/mrp1/ is committed on purpose. The prepared receptor,
# the docking cache, the saved poses and the ChEMBL cache are ~1.5 MB
# together and are what let a fresh clone run the whole loop offline, with
# no docking software and no API key.
.claude/
